# BLUETORN CRM — Production Environment Variables
# Copy this file to .env.production on your Hostinger Node.js server
# and fill in the real values from Hostinger's MySQL panel.
#
# NEVER commit real credentials to git.

# ─── Database (Hostinger MySQL) ─────────────────────────────────────────────
# Get these from: Hostinger hPanel → Hosting → Databases → MySQL databases
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Session Security ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# OR: node -e "require('crypto').randomBytes(32, (e,b) => console.log(b.toString('hex')))"
# MUST be at least 32 characters. Keep this secret!
SESSION_SECRET=

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
