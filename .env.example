# ==============================================================================
# BLUETORN CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# Target Production: https://realestate.bluetorn.com
# ==============================================================================
# Copy this file to .env on your server and set the actual values.
# NEVER commit your production .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE / RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on Hostinger/VPS.
# In production, cookies are marked 'Secure', requiring HTTPS.
NODE_ENV=production

# Host and Port where the Nitro / Node server will listen.
# Default port is 3000. On Hostinger Business Node.js, PORT is automatically managed.
# On VPS, configure Nginx to reverse proxy to this port.
PORT=3000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. PRODUCTION MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# On Hostinger Shared/Business hosting:
# If Node app runs on the same server, DB_HOST is usually 'localhost' or the Hostinger server hostname (e.g., srvXXXX.hstgr.io).
# On Hostinger VPS:
# Usually '127.0.0.1' or 'localhost'.
DB_HOST=localhost
DB_PORT=3306

# Your production Hostinger database name (e.g., u168098130_bluetorn_crm)
DB_NAME=u168098130_bluetorn_crm

# Your production Hostinger database username (e.g., u168098130_bluetorn_crm)
DB_USER=u168098130_bluetorn_crm

# Your strong production database password
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. TIMEZONE & LOCALE (Reference)
# ------------------------------------------------------------------------------
# The CRM application displays dates and times in Asia/Kolkata (IST).
# MySQL connection pool handles UTC datetime storage without timezone drift.
TZ=Asia/Kolkata
